# I3 CONFIG
# Translated from astralia/dots/hl/hypr. Per-window opacity, blur and rounding
# are handled by picom (dots/i3/picom/picom.conf). Wayland-only options
# (output scale, --locked binds, seat/input blocks) and the astralia
# desktop-shell (wlr-layer-shell only) were dropped.

# ===========
# VARIABLES
# ===========
set $mod Mod4
set $term terminal
set $browser browser
set $editor editor
set $filemanager file-manager
set $screenshot bash -c 'mkdir -p $HOME/Pictures/screenshots/ && maim -s $HOME/Pictures/screenshots/$(date +%Y-%m-%d_%H-%M-%S).png'
set $shell astralia-shell

# ===========
# APPEARANCE
# ===========
font pango:monospace 10
default_border pixel 5
default_floating_border pixel 5
# override _MOTIF_WM_HINTS (VS Code, Chromium) that request no border
for_window [all] border pixel 5
gaps inner 20
gaps outer 0

# class                 border   background text    indicator child_border
client.focused          #9B57F4  #9B57F4    #FFFFFF #9B57F4   #9B57F4
client.focused_inactive #5E50A0  #5E50A0    #FFFFFF #5E50A0   #5E50A0
client.unfocused        #5E50A0  #5E50A0    #FFFFFF #5E50A0   #5E50A0

# ===========
# AUTOSTART
# ===========
exec --no-startup-id picom
exec --no-startup-id astralia-shell
exec --no-startup-id fcitx5 -d
exec --no-startup-id dbus-update-activation-environment --systemd DISPLAY XDG_CURRENT_DESKTOP=i3

# ===========
# WINDOW STATE
# ===========
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r exec --no-startup-id "pkill -USR1 -x picom || picom -b", restart
bindsym $mod+f fullscreen toggle
bindsym $mod+v floating toggle

# ===========
# ASTRALIA
# ===========
bindsym Shift+space exec $shell launcher
bindsym $mod+q exec $shell logout

# ===========
# APPS
# ===========
bindsym $mod+b exec $browser
bindsym $mod+c exec $editor
bindsym $mod+e exec $filemanager
bindsym $mod+Shift+k exec $editor $HOME/astralia
bindsym $mod+Shift+s exec --no-startup-id $screenshot
bindsym $mod+t exec $term

# ===========
# WINDOW OPERATIONS
# ===========
bindsym $mod+Down focus down
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up move up
bindsym $mod+w kill

# ===========
# WORKSPACES
# ===========
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+0 workspace 10

bindsym $mod+Shift+1 move container to workspace 1; workspace 1
bindsym $mod+Shift+2 move container to workspace 2; workspace 2
bindsym $mod+Shift+3 move container to workspace 3; workspace 3
bindsym $mod+Shift+4 move container to workspace 4; workspace 4
bindsym $mod+Shift+5 move container to workspace 5; workspace 5
bindsym $mod+Shift+6 move container to workspace 6; workspace 6
bindsym $mod+Shift+7 move container to workspace 7; workspace 7
bindsym $mod+Shift+8 move container to workspace 8; workspace 8
bindsym $mod+Shift+9 move container to workspace 9; workspace 9
bindsym $mod+Shift+0 move container to workspace 10; workspace 10

# ===========
# MEDIA
# ===========
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-
bindsym XF86AudioMicMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86AudioMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 1%+
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl -e4 -n2 set 1%-
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl -e4 -n2 set 1%+

# ===========
# MOUSE
# ===========
floating_modifier $mod

# ===========
# LOCAL OVERRIDES
# ===========
include ~/.config/i3/local
