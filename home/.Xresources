! ===========
! SCALING
! ===========
Xft.dpi: 96

! ===========
! FONT
! ===========
XTerm*faceName: ComicShannsMono Nerd Font Mono
XTerm*faceSize: 15
XTerm*renderFont: true

! ===========
! BEHAVIOR
! ===========
XTerm*termName: xterm-256color
XTerm*locale: true
XTerm*utf8: 1
XTerm*metaSendsEscape: true
XTerm*backarrowKey: false
XTerm*ttyModes: erase ^?
XTerm*saveLines: 10000
XTerm*scrollBar: false
XTerm*internalBorder: 10
XTerm*selectToClipboard: true
XTerm*VT100.translations: #override \n\
    Ctrl Shift <Key>C: copy-selection(CLIPBOARD) \n\
    Ctrl Shift <Key>V: insert-selection(CLIPBOARD)

! ===========
! SIXEL
! ===========
XTerm*decTerminalID: vt340
XTerm*numColorRegisters: 256

! ===========
! CURSOR
! ===========
Xcursor.theme: Keqing
Xcursor.size: 24
XTerm*cursorBar: true
XTerm*cursorBlink: true

! ===========
! COLORS
! ===========
XTerm*background: #000000
XTerm*foreground: #F0ECF9
XTerm*cursorColor: #F0ECF9
XTerm*highlightColor: #1D113B
XTerm*highlightTextColor: #AB9DC8
XTerm*highlightReverse: false

XTerm*color0: #0A0614
XTerm*color1: #ff6b6b
XTerm*color2: #a8e6cf
XTerm*color3: #DBAA24
XTerm*color4: #806FBE
XTerm*color5: #9B57F4
XTerm*color6: #806FBE
XTerm*color7: #F0ECF9

XTerm*color8: #1D113B
XTerm*color9: #ff8e8e
XTerm*color10: #c3f0d8
XTerm*color11: #DBAA24
XTerm*color12: #CE8AFF
XTerm*color13: #806FBE
XTerm*color14: #AB9DC8
XTerm*color15: #F0ECF9
