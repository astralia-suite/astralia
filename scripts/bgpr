#!/usr/bin/env bash
# Usage: git-pull-all.sh <dir>  — git pull --rebase every repo directly inside <dir>
set -u
dir=${1:?usage: $0 <directory>}
[ -d "$dir" ] || { echo "not a directory: $dir" >&2; exit 1; }

fail=0
for d in "$dir"/*/; do
  [ -e "$d/.git" ] || continue  # .git is a dir, or a file for worktrees/submodules
  echo "==> $d"
  git -C "$d" pull --rebase || { echo "FAILED: $d" >&2; fail=1; }
done
exit $fail
