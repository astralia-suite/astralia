#!/usr/bin/env bash

set -u
[ $# -ge 1 ] || { echo "usage: $0 <directory>..." >&2; exit 2; }

fail=0
for dir in "$@"; do
  [ -d "$dir" ] || { echo "not a directory: $dir" >&2; fail=1; continue; }
  for d in "${dir%/}"/*/; do
    [ -e "$d/.git" ] || continue
    echo "==> $d"
    git -C "$d" pull --rebase || { echo "FAILED: $d" >&2; fail=1; }
  done
done
exit $fail
