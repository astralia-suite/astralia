#!/usr/bin/env bash

# Freeze the screen, select a region, save it to ~/Pictures/screenshots and copy it.
# Wayland: hyprpicker freezes, slurp selects, grim captures.
# X11: maim captures, feh shows it (i3 makes it fullscreen global), slop selects, magick crops.

[[ -n "$WAYLAND_DISPLAY" ]] && wl=true || wl=false
$wl && deps=(grim slurp hyprpicker wl-copy) || deps=(maim slop feh magick xclip)
for c in "${deps[@]}"; do command -v "$c" &>/dev/null || exit 1; done

save_dir="$HOME/Pictures/screenshots"
mkdir -p "$save_dir"
save_path="$save_dir/$(date +'%Y-%m-%d-%H%M%S')_screenshot.png"

if $wl; then
    hyprpicker -r -z &
    freeze_pid=$!
    sleep 0.2
    # Escape closes hyprpicker; take slurp down with it (sibling, so poll instead of wait)
    (
        while kill -0 "$freeze_pid" 2>/dev/null; do sleep 0.1; done
        pkill -x slurp
    ) &
    watcher_pid=$!
    geometry=$(slurp)
    kill "$freeze_pid" "$watcher_pid" 2>/dev/null
    [[ -n "$geometry" ]] || exit 0
    grim -g "$geometry" "$save_path"
    wl-copy --type image/png <"$save_path"
else
    # tmpfs + fastest png compression: the frozen frame is throwaway, keep slow CPUs/disks out of the way
    frozen=$(mktemp -p "${XDG_RUNTIME_DIR:-/tmp}" --suffix=.png)
    trap 'rm -f "$frozen"' EXIT
    maim -u -m 1 "$frozen"
    feh -x --title screenshot-freeze "$frozen" &
    freeze_pid=$!
    sleep 0.2
    geometry=$(slop -f '%g')
    kill "$freeze_pid" 2>/dev/null
    [[ -n "$geometry" ]] || exit 0
    magick "$frozen" -crop "$geometry" +repage "$save_path"
    xclip -selection clipboard -t image/png <"$save_path"
fi

notify-send "Screenshot saved" "$save_path" -i "$save_path" -a screenshot-region
